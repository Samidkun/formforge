# Copy to .env and fill in. NEVER commit real values.
APP_ENV=local
APP_KEY=
APP_URL=http://localhost

# Database
# Docker Compose dev (lihat docker-compose.yml)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=formforge
DB_USERNAME=formforge
DB_PASSWORD=devpass

REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# Mail (set SPF/DKIM/DMARC on the sending domain before production)
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
